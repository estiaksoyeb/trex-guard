#!/bin/sh
# tcx-trial - orientation-turn tally for the `prime` gate
#
# Usage:
#   tcx-trial log <control|treatment> <n>
#   tcx-trial show
#   tcx-trial reset
#
# Records how many orientation turns a chat session needed (from your first
# message to the AI's first edit-producing step). The gate asks whether
# `treatment` (starting with `tcx prime`) needs fewer turns than `control`.
#
# Log lives outside the repo so it is not committed.

set -e

LOG="${TCX_TRIAL_LOG:-${TCX_HOME:-$HOME/.local/share/tcx-home}/trial.log}"

case "$1" in
    log)
        arm="$2"
        n="$3"
        case "$arm" in
            control|treatment) ;;
            *) echo "arm must be control or treatment" >&2; exit 2 ;;
        esac
        case "$n" in
            ''|*[!0-9]*) echo "turns must be a non-negative integer" >&2; exit 2 ;;
        esac
        mkdir -p "$(dirname "$LOG")"
        printf '%s | %s | turns=%s\n' "$(date +%F)" "$arm" "$n" >> "$LOG"
        echo "logged: $arm turns=$n"
        ;;
    show)
        if [ ! -f "$LOG" ]; then
            echo "no trial data yet ($LOG)"
            exit 0
        fi
        cat "$LOG"
        echo "---"
        awk '
            /turns=/ {
                arm=""; turns=""
                for (i = 1; i <= NF; i++) {
                    if ($i == "control" || $i == "treatment") arm = $i
                    if ($i ~ /^turns=/) { split($i, a, "="); turns = a[2] }
                }
                if (arm != "" && turns != "") {
                    sum[arm] += turns
                    cnt[arm]++
                }
            }
            END {
                printf "control:   n=%d", cnt["control"] + 0
                if (cnt["control"] > 0) printf "  avg=%.2f", sum["control"] / cnt["control"]
                printf "\n"
                printf "treatment: n=%d", cnt["treatment"] + 0
                if (cnt["treatment"] > 0) printf "  avg=%.2f", sum["treatment"] / cnt["treatment"]
                printf "\n"
                if (cnt["control"] > 0 && cnt["treatment"] > 0) {
                    c = sum["control"] / cnt["control"]
                    t = sum["treatment"] / cnt["treatment"]
                    if (t + 0.5 <= c) printf "verdict: treatment wins (%.2f vs %.2f)\n", t, c
                    else if (c + 0.5 <= t) printf "verdict: treatment LOSES (%.2f vs %.2f)\n", t, c
                    else printf "verdict: no meaningful difference (%.2f vs %.2f)\n", t, c
                }
            }
        ' "$LOG"
        ;;
    reset)
        rm -f "$LOG"
        echo "trial log cleared"
        ;;
    *)
        sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
        exit 2
        ;;
esac
