#!/bin/sh
# tg - TREX Guard Launcher

set -e

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    echo "tg - TREX Guard Launcher"
    echo ""
    echo "Usage:"
    echo "  tg               Launch a guarded terminal shell"
    echo "  tg fresh         Print the prompt with this repo's Project section"
    echo "  tg resume        As fresh, plus what previous sessions learned"
    echo "  tg --help        Show this help message"
    echo "  tg --version     Show version information"
    exit 0
fi

if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
    echo "tg (trex-guard wrapper) 0.1.0"
    exit 0
fi

# Context commands: `tg fresh` and `tg resume` print a prompt to paste into a
# chat. They never start a shell, so they pass straight to `tcx`. This is the
# only one-way dependency: the guard calls tcx, never the reverse.
case "$1" in
    fresh|resume)
        if command -v tcx >/dev/null 2>&1; then
            exec tcx "$@"
        fi
        SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
        if [ -x "$SCRIPT_DIR/tcx" ]; then
            exec "$SCRIPT_DIR/tcx" "$@"
        fi
        echo "Error: tg $1 needs tcx, which was not found on PATH." >&2
        exit 1
        ;;
esac

# Prevent accidental recursive wrapping
is_force=0
for arg in "$@"; do
    if [ "$arg" = "--force" ]; then
        is_force=1
        break
    fi
done

if [ "$TREX_GUARD_ACTIVE" = "1" ] && [ "$is_force" -eq 0 ]; then
    echo "Notice: A guarded shell is already active in this terminal session." >&2
    echo "To launch anyway, run: tg --force" >&2
    exit 0
fi

# Locate trex-guard binary: PATH, or repo build directory
if command -v trex-guard >/dev/null 2>&1; then
    exec trex-guard "$@"
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$SCRIPT_DIR/../build/trex-guard" ]; then
    exec "$SCRIPT_DIR/../build/trex-guard" "$@"
fi

if [ -x "$SCRIPT_DIR/trex-guard" ]; then
    exec "$SCRIPT_DIR/trex-guard" "$@"
fi

echo "Error: trex-guard executable not found in PATH or adjacent directories." >&2
exit 1
